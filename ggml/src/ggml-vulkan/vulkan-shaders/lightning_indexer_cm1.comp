#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_shader_subgroup_basic : enable

#define BINDING_IDX_K 0u

#include "types.glsl"
#include "fa_types.glsl"
#define FaTypeV GGML_TYPE_F32

layout(constant_id = 0) const uint FaTypeK = GGML_TYPE_F32;
layout(constant_id = 1) const uint FaBlockBytesK = 4;

#include "flash_attn_dequant.glsl"

// cooperative-matrix variant of lightning_indexer.comp for many tokens: a workgroup scores
// BK keys against BT tokens. The key tile is staged once as f16; per head the query tile is
// staged as f16, every subgroup multiplies its 16 tokens with the keys in 16x16 blocks
// (f32 accumulation), and the rectified, weighted block is added to per-invocation scores.
// Requires subgroups of exactly 32 invocations.
#define HEAD_SIZE 128
#define SG_SIZE   32
#define NSG       4
#define WG_SIZE   (NSG * SG_SIZE)
#define BT        (NSG * 16)
#define BK        128
#define NKB       (BK / 16)
// elements of one 16x16 block owned by each invocation when read back
#define EPI       (16 * 16 / SG_SIZE)

layout(local_size_x = WG_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer QBuf { float q[]; };
layout(binding = 1) readonly buffer KBufF16 { float16_t k_f16[]; };
layout(binding = 1) readonly buffer KBufF32 { float k_f32[]; };
layout(binding = 1) readonly buffer KBufBF16 { uint16_t k_bf16[]; };
layout(binding = 2) readonly buffer WBuf { float weights[]; };
layout(binding = 3) readonly buffer MBuf { float16_t mask[]; };
layout(binding = 4) writeonly buffer DstBuf { float dst[]; };

layout(push_constant) uniform PushConstants {
    uint n_kv;
    uint n_heads;
    uint n_tokens;
    uint n_masks;
    uint q_nb1;
    uint q_nb2;
    uint q_nb3;
    uint k_nb2;
    uint k_nb3;
    uint w_nb1;
    uint w_nb3;
    uint m_nb1;
    uint m_nb3;
    uint d_nb1;
    uint d_nb3;
};

// row strides in f16vec4, padded against bank conflicts
#define ROW4 (HEAD_SIZE / 4 + 2)
shared f16vec4 k_sh[BK * ROW4];
shared f16vec4 q_sh[BT * ROW4];
shared float   s_sh[NSG * 16 * 16];
shared float   w_sh[BT];

void main() {
    const uint tid  = gl_LocalInvocationID.x;
    const uint sg   = tid / SG_SIZE;
    const uint lane = tid % SG_SIZE;
    const uint ik0  = gl_WorkGroupID.x * BK;
    const uint t0   = gl_WorkGroupID.y * BT;
    const uint s    = gl_WorkGroupID.z;

    if (fa_type_needs_shmem(FaTypeK)) {
        init_iq_shmem(gl_WorkGroupSize);
    }

    const uint k_block_elems = fa_block_elems(FaTypeK);
    const uint k_elem_bytes = FaBlockBytesK / k_block_elems;

    [[unroll]] for (uint i = tid; i < BK * HEAD_SIZE / 4; i += WG_SIZE) {
        const uint r = i / (HEAD_SIZE / 4);
        const uint c4 = i % (HEAD_SIZE / 4);

        vec4 v = vec4(0.0);
        if (ik0 + r < n_kv) {
            const uint k_offset = (ik0 + r) * k_nb2 + s * k_nb3;
            const uint e = k_offset / k_elem_bytes + c4 * 4;

            if (FaTypeK == GGML_TYPE_F16) {
                v = vec4(k_f16[e], k_f16[e + 1], k_f16[e + 2], k_f16[e + 3]);
            } else if (FaTypeK == GGML_TYPE_F32) {
                v = vec4(k_f32[e], k_f32[e + 1], k_f32[e + 2], k_f32[e + 3]);
            } else if (FaTypeK == GGML_TYPE_BF16) {
                v = bf16_to_fp32(uvec4(k_bf16[e], k_bf16[e + 1], k_bf16[e + 2], k_bf16[e + 3]));
            } else {
                v = dequantize4((c4 * 4) / k_block_elems, (c4 * 4) % k_block_elems, k_offset / FaBlockBytesK, BINDING_IDX_K);
            }
        }

        k_sh[r * ROW4 + c4] = f16vec4(v);
    }

    float score[NKB * EPI];
    [[unroll]] for (uint j = 0; j < NKB * EPI; ++j) {
        score[j] = 0.0;
    }

    for (uint h = 0; h < n_heads; ++h) {
        barrier();

        [[unroll]] for (uint i = tid; i < BT * HEAD_SIZE / 4; i += WG_SIZE) {
            const uint r = i / (HEAD_SIZE / 4);
            const uint c4 = i % (HEAD_SIZE / 4);
            const uint t = t0 + r;

            vec4 v = vec4(0.0);
            if (t < n_tokens) {
                const uint q_base = h * q_nb1 + t * q_nb2 + s * q_nb3 + c4 * 4;
                v = vec4(q[q_base], q[q_base + 1], q[q_base + 2], q[q_base + 3]);
            }
            q_sh[r * ROW4 + c4] = f16vec4(v);
        }

        if (tid < BT) {
            const uint t = t0 + tid;
            w_sh[tid] = t < n_tokens ? weights[h + t * w_nb1 + s * w_nb3] : 0.0;
        }

        barrier();

        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> qm[HEAD_SIZE / 16];
        [[unroll]] for (uint kk = 0; kk < HEAD_SIZE / 16; ++kk) {
            coopMatLoad(qm[kk], q_sh, (sg * 16) * ROW4 + kk * 4, ROW4, gl_CooperativeMatrixLayoutRowMajor);
        }

        [[unroll]] for (uint kb = 0; kb < NKB; ++kb) {
            coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc =
                coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

            [[unroll]] for (uint kk = 0; kk < HEAD_SIZE / 16; ++kk) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> km;
                coopMatLoad(km, k_sh, (kb * 16) * ROW4 + kk * 4, ROW4, gl_CooperativeMatrixLayoutColumnMajor);
                acc = coopMatMulAdd(qm[kk], km, acc);
            }

            coopMatStore(acc, s_sh, sg * 256, 16, gl_CooperativeMatrixLayoutRowMajor);
            subgroupMemoryBarrierShared();
            subgroupBarrier();

            [[unroll]] for (uint e = 0; e < EPI; ++e) {
                const uint idx = lane + e * SG_SIZE;
                const uint r = idx / 16;
                score[kb * EPI + e] += max(s_sh[sg * 256 + idx], 0.0) * w_sh[sg * 16 + r];
            }

            subgroupMemoryBarrierShared();
            subgroupBarrier();
        }
    }

    [[unroll]] for (uint kb = 0; kb < NKB; ++kb) {
        [[unroll]] for (uint e = 0; e < EPI; ++e) {
            const uint idx = lane + e * SG_SIZE;
            const uint t  = t0 + sg * 16 + idx / 16;
            const uint ik = ik0 + kb * 16 + idx % 16;
            if (t < n_tokens && ik < n_kv) {
                const uint mask_offset = ik + t * m_nb1 + (s % n_masks) * m_nb3;
                dst[ik + t * d_nb1 + s * d_nb3] = score[kb * EPI + e] + float(mask[mask_offset]);
            }
        }
    }
}
